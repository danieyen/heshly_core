class MockRepository:


    def __init__(self):

        self.items = []


    def save(
        self,
        item,
    ):

        self.items.append(item)

        return item


    def get(
        self,
        item_id,
    ):

        for item in self.items:

            if getattr(
                item,
                "id",
                None
            ) == item_id:

                return item

        return None


    def list(self):

        return self.items


    def delete(
        self,
        item_id,
    ):

        self.items = [
            item
            for item in self.items
            if getattr(item, "id", None)
            != item_id
        ]


def test_security_services():

    print("\n================================")
    print("Security Services Test")
    print("================================\n")

    # =====================================================
    # Shared Dependencies
    # =====================================================

    audit_repository = AuditRepository()

    metrics = SecurityMetrics()

    alerts = SecurityAlerts()

    intrusion = IntrusionDetection()

    audit = AuditService(
        audit_repository
    )

    tracker = ActivityTracker(
        audit
    )

    compliance = ComplianceReporting(
        audit_repository
    )

    dashboard = SecurityDashboard(
        metrics,
        alerts,
        intrusion,
    )

    alert_manager = AlertManager(
        alerts
    )

    incident_reporting = IncidentReporting(
        metrics,
        intrusion,
        alert_manager,
    )

    encryption_service = EncryptionService(
    secret="test-encryption-secret"
    )

    # =====================================================
    # Container
    # =====================================================

    services = SecurityServices(

        authentication_manager=AuthenticationService(),

        authorization_manager=AuthorizationManager(    role_repository=MockRepository(),    permission_repository=MockRepository(),    assignment_repository=MockRepository(),),

        session_manager=SessionManager(),

        token_manager=TokenManager(),

        jwt_manager=JWTManager(    secret="test-secret-key"),

        refresh_token_manager=RefreshTokenManager(),

        token_revocation=TokenRevocation(),

        encryption_service=encryption_service,

        secret_manager=SecretManager(    encryption_service=encryption_service),

        secure_configuration=SecureConfiguration(    secret_manager=secret_manager),

        data_masking=DataMasking(),

        sensitive_data_protection=SensitiveDataProtection(),

        audit_service=audit,

        activity_tracker=tracker,

        compliance_reporting=compliance,

        brute_force_protection=BruteForceProtection(),

        account_lockout=AccountLockout(),

        suspicious_activity_detection=SuspiciousActivityDetection(),

        ip_allow_deny_lists=IPAccessControl(),

        security_alerts=alerts,

        security_metrics=metrics,

        intrusion_detection=intrusion,

        security_dashboard=dashboard,

        alert_manager=alert_manager,

        incident_reporting=incident_reporting,

    )

    print("✅ Container created")

    # =====================================================
    # Service Access
    # =====================================================

    assert services.authentication is not None

    assert services.authorization is not None

    assert services.sessions is not None

    assert services.tokens is not None

    assert services.jwt is not None

    assert services.encryption is not None

    assert services.audit is not None

    assert services.monitoring is not None

    assert services.alerts is not None

    assert services.metrics is not None

    assert services.intrusion is not None

    print("✅ Convenience accessors")

    # =====================================================
    # Registry
    # =====================================================

    assert services.has(
        "authentication_manager"
    )

    assert services.has(
        "audit_service"
    )

    assert services.get(
        "jwt_manager"
    ) is not None

    assert len(
        services.names()
    ) == 25

    print("✅ Registry")

    # =====================================================
    # Health
    # =====================================================

    health = services.health()

    assert (
        health["status"]
        ==
        "healthy"
    )

    assert len(
        health["services"]
    ) == 25

    print("✅ Health aggregation")

    print(
        "\n🎉 SECURITY SERVICES TEST PASSED\n"
    )

